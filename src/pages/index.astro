---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import EducationList from '../components/EducationList.astro';
import ExperienceList from '../components/ExperienceList.astro';
import Hero from '../components/Hero.astro';
import ProjectList from '../components/ProjectList.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SkillList from '../components/SkillList.astro';
import {
	getEducation,
	getExperience,
	getHero,
	getProfile,
	getProjects,
	getSkills,
} from '../lib/content';

const hero = await getHero();
const profile = await getProfile();
const projects = await getProjects();
const jobs = await getExperience();
const education = await getEducation();
const skills = await getSkills();
---

<BaseLayout description={`${profile.tagline} Projects, experience and contact.`}>
	<main id="main" class="frame">
		<Hero {...hero} name={profile.name} tagline={profile.tagline} links={profile.links} />

		<section id="projects" aria-labelledby="projects-heading">
			<SectionHeader number="01" title="Projects" id="projects-heading" />
			<ProjectList projects={projects} />
		</section>

		<section id="experience" aria-labelledby="experience-heading">
			<SectionHeader number="02" title="Experience" id="experience-heading" />
			<ExperienceList jobs={jobs} />
			<EducationList entries={education} />
		</section>

		<section id="skills" aria-labelledby="skills-heading">
			<SectionHeader number="03" title="Skills" id="skills-heading" />
			<SkillList groups={skills} />
		</section>

		<Contact name={profile.name} email={profile.email} availability={profile.availability} />
	</main>
</BaseLayout>
