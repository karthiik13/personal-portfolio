---
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

<ul class="tags" role="list" aria-label="Tags">
	{tags.map((tag) => (
		<li class="label">{tag}</li>
	))}
</ul>

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: 0;
		list-style: none;
	}

	li {
		padding: var(--space-1) var(--space-2);
		border: var(--hairline);
		color: var(--muted);
	}
</style>
