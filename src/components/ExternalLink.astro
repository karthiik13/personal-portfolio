---
// Link that opens in a new tab, marked with ↗ and announced to screen readers.
interface Props {
	href: string;
	class?: string;
}

const { href, class: className } = Astro.props;
---

<a class:list={['external', className]} href={href} target="_blank" rel="noopener">
	<slot />
	<span aria-hidden="true"> ↗</span>
	<span class="visually-hidden"> (opens in a new tab)</span>
</a>
