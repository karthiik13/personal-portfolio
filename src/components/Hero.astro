---
import type { HeroContent, ProfileLink } from '../lib/content';

type Props = HeroContent & { links: ProfileLink[] };

const { heading, intro, links, now } = Astro.props;
const isExternal = (href: string) => href.startsWith('http');
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="cell main-cell">
		<h1 id="hero-heading">
			<span class="visually-hidden">Karthik Sudarsan, </span>
			{heading}
		</h1>

		<div class="details">
			<div class="intro">
				{intro.map((line) => (
					<p>{line}</p>
				))}
			</div>

			<ul class="links" role="list">
				{links.map((link) => (
					<li>
						<a
							class="label u-link"
							href={link.href}
							{...(isExternal(link.href) && { target: '_blank', rel: 'noopener' })}
						>
							{link.label}
							{isExternal(link.href) && (
								<>
									<span class="arrow" aria-hidden="true">
										↗
									</span>
									<span class="visually-hidden"> (opens in a new tab)</span>
								</>
							)}
						</a>
					</li>
				))}
			</ul>
		</div>
	</div>

	<p class="cell now">
		<span class="label now-label">Now ·</span>
		{now}
	</p>
</section>

<style>
	.hero {
		border-bottom: var(--hairline);
	}

	.cell {
		padding-inline: var(--gutter);
	}

	.main-cell {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
		padding-block: var(--space-16) var(--space-12);
	}

	h1 {
		font-size: var(--text-display);
		/* Lines of a two-line display heading sit tight, like a printed poster. */
		line-height: 0.9;
	}

	/* Intro on the left, links bottom-right; wraps to a stack on narrow screens. */
	.details {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-8) var(--space-12);
	}

	.intro {
		flex: 1 1 28rem;
		max-width: 38rem;
		font-size: var(--text-lg);
		color: var(--muted);
	}

	.intro p + p {
		margin-top: var(--space-2);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
		padding: 0;
		list-style: none;
	}

	.links a {
		display: inline-block;
		padding-block: var(--space-2);
	}

	.now {
		padding-block: var(--space-4);
		border-top: var(--hairline);
		font-size: var(--text-sm);
	}

	.now-label {
		color: var(--accent);
		margin-right: var(--space-2);
	}

	/* On load: heading, details, then the Now strip fade up in sequence. */
	@media (prefers-reduced-motion: no-preference) {
		.main-cell > *,
		.now {
			animation: hero-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}

		.main-cell > :nth-child(2) {
			animation-delay: 120ms;
		}

		.now {
			animation-delay: 240ms;
		}
	}

	@keyframes hero-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}
</style>
