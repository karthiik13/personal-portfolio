---
// Light/dark toggle. The saved choice lives in localStorage.theme,
// which BaseLayout's inline script reads before first paint.
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle colour theme">
	<!-- Moon: shown in light mode (click → dark) -->
	<svg class="icon icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
		<path
			d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linejoin="round"></path>
	</svg>
	<!-- Sun: shown in dark mode (click → light) -->
	<svg class="icon icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
		<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
		<path
			d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"></path>
	</svg>
</button>

<style>
	.theme-toggle {
		display: inline-grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		background: transparent;
		color: var(--ink);
		border: var(--hairline);
		cursor: pointer;
	}

	.theme-toggle:hover {
		color: var(--accent);
		border-color: currentColor;
	}

	/* Icon visibility uses the same selectors as the tokens in global.css,
	   so the right icon shows on first paint, before any JS runs. */
	.icon-sun {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .icon-sun {
			display: block;
		}
		:global(:root:not([data-theme='light'])) .icon-moon {
			display: none;
		}
	}

	:global(:root[data-theme='dark']) .icon-sun {
		display: block;
	}
	:global(:root[data-theme='dark']) .icon-moon {
		display: none;
	}
</style>

<script>
	const root = document.documentElement;
	const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

	function currentTheme(): 'light' | 'dark' {
		const set = root.dataset.theme;
		if (set === 'light' || set === 'dark') return set;
		return systemDark.matches ? 'dark' : 'light';
	}

	function syncLabels() {
		const next = currentTheme() === 'dark' ? 'light' : 'dark';
		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
			btn.setAttribute('aria-label', `Switch to ${next} theme`);
		});
	}

	document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const next = currentTheme() === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {
				// Storage blocked (private mode etc.) — theme still changes for this page view.
			}
			syncLabels();
		});
	});

	// Keep the label right if the system theme changes while no choice is saved.
	systemDark.addEventListener('change', syncLabels);
	syncLabels();
</script>
